The column types of a WFS data source (#1295): the list, each entry in the
shared column type form of lib.datasource.base (ui-column-type.xmi). The
rest of the data source settings is not a form model yet.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="WfsColumnsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.lib.datasource.wfs#//IWfsStoreConfiguration"/>

  <components xsi:type="uimodel:FormView" name="WfsColumnsFormView">
    <fields xsi:type="uimodel:InputWidget"
        name="columnTypes"
        feature="http://org.eclipse.daanse.board.app.lib.datasource.wfs#//IWfsStoreConfiguration/columnTypes"
        label="datasourceWfs:Settings.columnTypes"/>
  </components>
</uimodel:UIModel>
