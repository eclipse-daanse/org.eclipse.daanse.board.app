<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="dateTimePickerVariable"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.variable.timepicker" nsPrefix="dateTimePickerVariable">
    <eClassifiers xsi:type="ecore:EClass" name="DateTimePickerVariableSettings">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="What a date and time variable is told: the moment it stands for."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="datetime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The moment, as ISO 8601. The form edits it in local time, because that is the time a person is thinking in."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
</ecore:EPackage>
