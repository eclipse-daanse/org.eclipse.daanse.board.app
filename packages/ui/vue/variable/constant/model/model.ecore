<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="constantVariable"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.variable.constant" nsPrefix="constantVariable">
    <eClassifiers xsi:type="ecore:EClass" name="ConstantVariableSettings">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="What a constant variable is told: the value it stands for, and nothing else - a constant does not go and fetch anything."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="What it stands for. Read as text; a widget that wants a number reads one out of it."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
</ecore:EPackage>
