The form for the visual widget.

The kind comes first, because it decides what else there is to ask: the
three axes only for points, the value column only for what is sized by one
value, the motion only for what moves. A field a kind does not read is not
shown for it, so the form never offers a setting that does nothing.

The kind is compared by the enum's name in capitals: the model stores the
name, a board written by hand may hold the literal, and both read the same.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="VisualSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings"/>

  <components xsi:type="uimodel:FormView" name="VisualSettingsFormView">

    <fields xsi:type="uimodel:GroupWidget" name="drawGroup" layout="VERTICAL" label="visual:Form.drawGroup">
      <fields xsi:type="uimodel:SelectWidget" name="kind"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/kind" label="visual:Form.kind">
        <values>BARS3D</values>
        <values>SURFACE</values>
        <values>SCATTER3D</values>
        <values>SUNBURST</values>
        <values>TREEMAP</values>
        <values>SANKEY</values>
        <values>RACE</values>
        <values>CALENDAR</values>
        <optionLabel language="JS" body="'visual:Options.kind.' + String(option).toLowerCase()"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="title"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/title" label="visual:Form.title"/>
      <fields xsi:type="uimodel:SelectWidget" name="palette"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/palette" label="visual:Form.palette">
        <values>AURORA</values>
        <values>OCEAN</values>
        <values>SUNSET</values>
        <values>FOREST</values>
        <values>MONO</values>
        <optionLabel language="JS" body="'visual:Options.palette.' + String(option).toLowerCase()"/>
      </fields>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="columnsGroup" layout="VERTICAL" label="visual:Form.columnsGroup">
      <visibilityCondition language="JS" body="!['BARS3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:InputWidget" name="xColumn"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/xColumn" label="visual:Form.xColumn">
        <visibilityCondition language="JS" body="['SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="yColumn"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/yColumn" label="visual:Form.yColumn">
        <visibilityCondition language="JS" body="['SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="zColumn"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/zColumn" label="visual:Form.zColumn">
        <visibilityCondition language="JS" body="['SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="sizeColumn"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/sizeColumn" label="visual:Form.sizeColumn">
        <visibilityCondition language="JS" body="['SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:InputWidget" name="valueColumn"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/valueColumn" label="visual:Form.valueColumn" placeholder="visual:Placeholder.column">
        <visibilityCondition language="JS" body="['SUNBURST'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:InputWidget" name="pathSeparator"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/pathSeparator" label="visual:Form.pathSeparator">
        <visibilityCondition language="JS" body="['SUNBURST'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['TREEMAP'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['TREEMAP'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['SANKEY'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['SANKEY'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['CALENDAR'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="motionGroup" layout="VERTICAL" label="visual:Form.motionGroup">
      <visibilityCondition language="JS" body="['BARS3D', 'SURFACE', 'SCATTER3D', 'RACE'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="autoRotate"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/autoRotate" label="visual:Form.autoRotate">
        <visibilityCondition language="JS" body="['BARS3D', 'SURFACE', 'SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:NumberWidget" name="topN"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/topN" label="visual:Form.topN" min="1" max="50" step="1">
        <visibilityCondition language="JS" body="['RACE'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:NumberWidget" name="frameDuration"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/frameDuration" label="visual:Form.frameDuration" min="200" max="20000" step="100">
        <visibilityCondition language="JS" body="['RACE'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="displayGroup" layout="VERTICAL" label="visual:Form.displayGroup">
      <visibilityCondition language="JS" body="['BARS3D', 'SURFACE', 'SCATTER3D', 'SUNBURST', 'TREEMAP', 'SANKEY', 'RACE'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="showScale"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showScale" label="visual:Form.showScale">
        <visibilityCondition language="JS" body="['BARS3D', 'SURFACE', 'SCATTER3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:CheckboxWidget" name="showLabels"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showLabels" label="visual:Form.showLabels">
        <visibilityCondition language="JS" body="['SUNBURST'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:CheckboxWidget" name="showLabels"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showLabels" label="visual:Form.showLabels">
        <visibilityCondition language="JS" body="['TREEMAP'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:CheckboxWidget" name="showLabels"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showLabels" label="visual:Form.showLabels">
        <visibilityCondition language="JS" body="['SANKEY'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
      <fields xsi:type="uimodel:CheckboxWidget" name="showLabels"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showLabels" label="visual:Form.showLabels">
        <visibilityCondition language="JS" body="['RACE'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <visibilityCondition language="JS" body="['BARS3D', 'CALENDAR'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
        <visibilityCondition language="JS" body="['BARS3D', 'CALENDAR'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
    </fields>

  </components>
</uimodel:UIModel>
