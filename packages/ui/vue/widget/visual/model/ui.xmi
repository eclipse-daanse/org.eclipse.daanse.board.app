The form for the visual widget.

The kind comes first, because it decides what else there is to ask: the
three axes only for points, the value column only for what is sized by one
value, the motion only for what moves. A field a kind does not read is not
shown for it, so the form never offers a setting that does nothing.

The kind is compared by the enum's name in capitals: the model stores the
name, a board written by hand may hold the literal, and both read the same.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="VisualSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings"/>

  <components xsi:type="uimodel:FormView" name="VisualSettingsFormView">

    <fields xsi:type="uimodel:GroupWidget" name="drawGroup" layout="VERTICAL" label="visual:Form.drawGroup">
      <fields xsi:type="uimodel:SelectWidget" name="kind"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/kind" label="visual:Form.kind">
        <values>BARS3D</values>
        <optionLabel language="JS" body="'visual:Options.kind.' + String(option).toLowerCase()"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="title"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/title" label="visual:Form.title"/>
      <fields xsi:type="uimodel:SelectWidget" name="palette"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/palette" label="visual:Form.palette">
        <values>AURORA</values>
        <values>OCEAN</values>
        <values>SUNSET</values>
        <values>FOREST</values>
        <values>MONO</values>
        <optionLabel language="JS" body="'visual:Options.palette.' + String(option).toLowerCase()"/>
      </fields>
    </fields>


    <fields xsi:type="uimodel:GroupWidget" name="motionGroup" layout="VERTICAL" label="visual:Form.motionGroup">
      <visibilityCondition language="JS" body="['BARS3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="autoRotate"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/autoRotate" label="visual:Form.autoRotate">
        <visibilityCondition language="JS" body="['BARS3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="displayGroup" layout="VERTICAL" label="visual:Form.displayGroup">
      <visibilityCondition language="JS" body="['BARS3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="showScale"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.visual#//VisualSettings/showScale" label="visual:Form.showScale">
        <visibilityCondition language="JS" body="['BARS3D'].includes(String(self.kind ?? 'BARS3D').toUpperCase().replace(/_/g, ''))"/>
      </fields>
    </fields>

  </components>
</uimodel:UIModel>
