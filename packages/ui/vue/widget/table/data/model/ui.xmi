The form for the data table.

Three groups: what the table shows, how its header looks, and how the
rows, columns and cells a rule marks look. Which columns are shown
is not here - the model has no idea what columns an answer carries, so that
question is asked by a hand-written section beside this one.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="DataTableSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings"/>

  <components xsi:type="uimodel:FormView" name="DataTableSettingsFormView">
    <fields xsi:type="uimodel:GroupWidget" name="rowsGroup" layout="VERTICAL" label="tableData:Form.rowsGroup">
      <fields xsi:type="uimodel:NumberWidget" name="pageSize"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/pageSize" label="tableData:Form.pageSize"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="sortable"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/sortable" label="tableData:Form.sortable"/>
    </fields>
    <fields xsi:type="uimodel:GroupWidget" name="headerGroup" layout="VERTICAL" label="tableData:Form.headerGroup">
      <fields xsi:type="uimodel:CheckboxWidget" name="showHeader"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/showHeader" label="tableData:Form.showHeader"/>
      <fields xsi:type="uimodel:InputWidget" name="headerBackground"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/headerBackground" label="tableData:Form.headerBackground"/>
    </fields>
    <fields xsi:type="uimodel:GroupWidget" name="marksGroup" layout="VERTICAL" label="tableData:Form.marksGroup">
      <fields xsi:type="uimodel:InputWidget" name="markedRowColor"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/markedRowColor" label="tableData:Form.markedRowColor"/>
      <fields xsi:type="uimodel:InputWidget" name="markedColumnColor"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/markedColumnColor" label="tableData:Form.markedColumnColor"/>
      <fields xsi:type="uimodel:InputWidget" name="markedCellColor"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data#//DataTableSettings/markedCellColor" label="tableData:Form.markedCellColor"/>
    </fields>
  </components>
</uimodel:UIModel>
