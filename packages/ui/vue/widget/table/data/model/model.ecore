The data table's settings.

The colour is a wrapper, like every other value an application setting
can take from a variable - which is how one board shows the same table in
two states without a second table. The rest are switches and a count: they
say how the table is drawn, not what it shows, and nothing points a
variable at them.
-->
<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="datatablesettings"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data"
                nsPrefix="datatablesettings">

    <eClassifiers xsi:type="ecore:EClass" name="DataTableSettings">
        <eStructuralFeatures xsi:type="ecore:EReference" name="headerBackground" containment="false" defaultValueLiteral="var(--color-raised)">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="showHeader"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                             defaultValueLiteral="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether the row of column names is drawn. Off for a table that sits on a board as a field of numbers whose columns speak for themselves."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="sortable"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                             defaultValueLiteral="false">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether a click on a column name orders the rows by it. Off by default because a header click already announces itself to the event system, and a board built on that should not start sorting underneath it."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="pageSize"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="How many rows a page holds. Zero means the whole answer at once, which is what this table did before there were pages."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="hiddenColumns"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                             upperBound="-1">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The columns left out, by name. Said this way round so that a column the answer grows later is shown rather than silently missing."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
    <!--
    What the table tells the event system when it is clicked (#1221).

    A rule on a row click is there to do something with that row - set a
    variable from one of its values, point a gauge at it - so the row goes
    with the event, as the record the source answered, not as a number
    that someone would have to look up again.

    Every index here counts the answer as the table was handed it: rows in
    the order the source sent them, columns in the order the source's
    records name them. Not the order on screen. A sort changes neither
    index, and a column left out under hiddenColumns keeps its place in the
    count, so the columns after it keep theirs: a rule written against the
    third column still means the third column after someone hides the
    first.
    -->
    <eClassifiers xsi:type="ecore:EDataType" name="Record" instanceTypeName="Record&lt;string, unknown&gt;">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="One record of the source's answer, by column name. Said as its own type so that whoever offers the payload's fields knows this one has fields of its own - the columns - and can offer row.&lt;column&gt;."/>
        </eAnnotations>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableRowPayload" eSuperTypes="http://org.eclipse.daanse.board.app.lib.events#//Payload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a row is clicked or right-clicked."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="row" eType="#//Record" lowerBound="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The clicked row, as the source answered it - hidden columns included, since hiding is about the screen and not about what the row holds."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="rowIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The row's position in the source's answer, counted from zero. Not its position on screen: neither a sort nor the page it is on changes it."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableCellPayload" eSuperTypes="#//DataTableRowPayload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a cell is clicked or right-clicked: the row it is in, and which of its values."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The cell's column, by name - the key of the value in row."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column's position among the source's columns, counted from zero. Hidden columns are counted: hiding one does not move the index of those after it."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EJavaObject" lowerBound="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The cell's value, as the source answered it - the same as row[column]."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableColumnPayload" eSuperTypes="http://org.eclipse.daanse.board.app.lib.events#//Payload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a column header is clicked or right-clicked."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column, by name - the key its values have in a row."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column's position among the source's columns, counted from zero. Hidden columns are counted: hiding one does not move the index of those after it."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
</ecore:EPackage>
