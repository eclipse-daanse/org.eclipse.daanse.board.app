The data table's settings.

The colour is a wrapper, like every other value an application setting
can take from a variable - which is how one board shows the same table in
two states without a second table. The rest are switches and a count: they
say how the table is drawn, not what it shows, and nothing points a
variable at them.
-->
<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="datatablesettings"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.widget.table.data"
                nsPrefix="datatablesettings">

    <eClassifiers xsi:type="ecore:EClass" name="DataTableSettings">
        <eStructuralFeatures xsi:type="ecore:EReference" name="headerBackground" containment="false" defaultValueLiteral="var(--color-raised)">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="showHeader"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                             defaultValueLiteral="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether the row of column names is drawn. Off for a table that sits on a board as a field of numbers whose columns speak for themselves."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="sortable"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
                             defaultValueLiteral="false">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether a click on a column name orders the rows by it. Off by default because a header click already announces itself to the event system, and a board built on that should not start sorting underneath it."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="pageSize"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="How many rows a page holds. Zero means the whole answer at once, which is what this table did before there were pages."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="hiddenColumns"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                             upperBound="-1">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The columns left out, by name. Said this way round so that a column the answer grows later is shown rather than silently missing."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="markedRowColor"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                             defaultValueLiteral="color-mix(in srgb, var(--color-accent) 18%, transparent)">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The background of a row a rule marked. Marks are set by rules while the board runs and are not saved; only how they look is."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="markedColumnColor"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                             defaultValueLiteral="color-mix(in srgb, var(--color-accent) 12%, transparent)">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The background of the cells of a column a rule marked."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EAttribute" name="markedCellColor"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
                             defaultValueLiteral="color-mix(in srgb, var(--color-accent) 40%, transparent)">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The background of a cell a rule marked, and of the cell where a marked row crosses a marked column - stronger than either, so the crossing stands out."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="colorRules" eType="#//DataTableColorRule" lowerBound="0" upperBound="-1" containment="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Colours a cell or a row by a value of the row (#1265). In order: the first rule that matches a cell decides its colour. A rule wins over a colour the source sends with a value; that one stays as the default."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="filterRules" eType="#//DataTableFilterRule" lowerBound="0" upperBound="-1" containment="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Which rows are shown (#1265). A presentation of the answer, not a selection of it: sorting, paging and the indices of a click payload work on the answer as the source sent it, and only the rows that pass are drawn."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="filterMatch" eType="#//DataTableFilterMatch" defaultValueLiteral="all">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether a row must pass every filter rule or one of them."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
    <!--
    What the table tells the event system when it is clicked (#1221).

    A rule on a row click is there to do something with that row - set a
    variable from one of its values, point a gauge at it - so the row goes
    with the event, as the record the source answered, not as a number
    that someone would have to look up again.

    Every index here counts the answer as the table was handed it: rows in
    the order the source sent them, columns in the order the source's
    records name them. Not the order on screen. A sort changes neither
    index, and a column left out under hiddenColumns keeps its place in the
    count, so the columns after it keep theirs: a rule written against the
    third column still means the third column after someone hides the
    first.
    -->
    <eClassifiers xsi:type="ecore:EDataType" name="Record" instanceTypeName="Record&lt;string, unknown&gt;">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="One record of the source's answer, by column name. Said as its own type so that whoever offers the payload's fields knows this one has fields of its own - the columns - and can offer row.&lt;column&gt;."/>
        </eAnnotations>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableRowPayload" eSuperTypes="http://org.eclipse.daanse.board.app.lib.events#//Payload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a row is clicked or right-clicked."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="row" eType="#//Record" lowerBound="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The clicked row, as the source answered it - hidden columns included, since hiding is about the screen and not about what the row holds."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="rowIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The row's position in the source's answer, counted from zero. Not its position on screen: neither a sort nor the page it is on changes it."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableCellPayload" eSuperTypes="#//DataTableRowPayload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a cell is clicked or right-clicked: the row it is in, and which of its values."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The cell's column, by name - the key of the value in row."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column's position among the source's columns, counted from zero. Hidden columns are counted: hiding one does not move the index of those after it."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EJavaObject" lowerBound="0">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The cell's value, as the source answered it - the same as row[column]."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableColumnPayload" eSuperTypes="http://org.eclipse.daanse.board.app.lib.events#//Payload">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Sent when a column header is clicked or right-clicked."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column, by name - the key its values have in a row."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column's position among the source's columns, counted from zero. Hidden columns are counted: hiding one does not move the index of those after it."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="DataTableCondition">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="How a rule compares a value of the row with its own value. A rule holds the name (EQUALS); the literal (equals) is read as well. Numbers are compared as numbers where both sides are numbers, everything else as text."/>
        </eAnnotations>
        <eLiterals name="EQUALS" literal="equals"/>
        <eLiterals name="NOT_EQUALS" literal="notEquals" value="1"/>
        <eLiterals name="CONTAINS" literal="contains" value="2"/>
        <eLiterals name="GREATER_THAN" literal="greaterThan" value="3"/>
        <eLiterals name="LESS_THAN" literal="lessThan" value="4"/>
        <eLiterals name="BETWEEN" literal="between" value="5"/>
        <eLiterals name="EMPTY" literal="empty" value="6"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="DataTableFilterMatch">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Whether a row must pass every filter rule (ALL) or one of them (ANY). The name is held; the literal is read as well."/>
        </eAnnotations>
        <eLiterals name="ALL" literal="all"/>
        <eLiterals name="ANY" literal="any" value="1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="DataTableColorTarget">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="What a colour rule paints: the cell of its column, or every cell of the row."/>
        </eAnnotations>
        <eLiterals name="CELL" literal="cell"/>
        <eLiterals name="ROW" literal="row" value="1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableColorRule">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A colour for the cells, or the rows, whose value in one column meets a condition."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column whose value is compared, by name."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="condition" eType="#//DataTableCondition" defaultValueLiteral="equals">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="How the value is compared."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="What the value is compared with. May name variables as {name}; their current values are put in."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The upper end for between, which includes both ends. Unused by the other conditions."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The background, as a CSS colour."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="textColor" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The text colour, as a CSS colour. Empty: dark or light, whichever reads on the background; a background not written in hex keeps the table's text colour."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="target" eType="#//DataTableColorTarget" defaultValueLiteral="cell">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Whether the rule paints the cell of its column or the whole row."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataTableFilterRule">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A condition a row has to meet to be shown."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="column" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The column whose value is compared, by name."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="condition" eType="#//DataTableCondition" defaultValueLiteral="equals">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="How the value is compared."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="What the value is compared with. May name variables as {name}; their current values are put in."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The upper end for between, which includes both ends. Unused by the other conditions."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>
</ecore:EPackage>
