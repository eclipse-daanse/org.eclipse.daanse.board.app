The size of a model from fields of its point (#1296).
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="SizeEncodingForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//SizeEncoding"/>

  <components xsi:type="uimodel:FormView" name="SizeEncodingFormView">
    <fields xsi:type="uimodel:InputWidget" name="height" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//SizeEncoding/height" label="maplibre:Symbols.SizeEncoding.height"/>
    <fields xsi:type="uimodel:InputWidget" name="width" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//SizeEncoding/width" label="maplibre:Symbols.SizeEncoding.width"/>
  </components>
</uimodel:UIModel>
