A value and the colour it gives (#1296).
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="ColorMappingForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ColorMapping"/>

  <components xsi:type="uimodel:FormView" name="ColorMappingFormView">
    <fields xsi:type="uimodel:InputWidget" name="code" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ColorMapping/code" label="maplibre:Symbols.ColorMapping.code"/>
    <fields xsi:type="uimodel:InputWidget" name="color" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ColorMapping/color" label="maplibre:Symbols.ColorMapping.color"/>
  </components>
</uimodel:UIModel>
