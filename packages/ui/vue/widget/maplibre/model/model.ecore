    <eClassifiers xsi:type="ecore:EClass" name="GeoJsonLayer">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="GeoJSON on the map: points, lines and areas, from an address or written in."/>
