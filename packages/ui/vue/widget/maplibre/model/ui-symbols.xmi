The symbol layers of the 3D map (#1296): the list, each layer in ui-model-layer.xmi. The other sections of the map settings are not a form model yet.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="SymbolLayersForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//MapLibreSettings"/>

  <components xsi:type="uimodel:FormView" name="SymbolLayersFormView">
    <fields xsi:type="uimodel:InputWidget" name="modelLayers" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//MapLibreSettings/modelLayers" label="maplibre:Symbols.MapLibreSettings.modelLayers"/>
  </components>
</uimodel:UIModel>
