Which model file a point gets, by a field (#1296).
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="ModelEncodingForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ModelEncoding"/>

  <components xsi:type="uimodel:FormView" name="ModelEncodingFormView">
    <fields xsi:type="uimodel:ComboboxWidget" name="field" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ModelEncoding/field" label="maplibre:Symbols.ModelEncoding.field"/>
    <fields xsi:type="uimodel:InputWidget" name="mappings" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//ModelEncoding/mappings" label="maplibre:Symbols.ModelEncoding.mappings"/>
  </components>
</uimodel:UIModel>
