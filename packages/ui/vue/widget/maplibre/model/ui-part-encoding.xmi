Meshes of a model with a colour of their own (#1296).
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="PartEncodingForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//PartEncoding"/>

  <components xsi:type="uimodel:FormView" name="PartEncodingFormView">
    <fields xsi:type="uimodel:InputWidget" name="mesh" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//PartEncoding/mesh" label="maplibre:Symbols.PartEncoding.mesh"/>
    <fields xsi:type="uimodel:InputWidget" name="color" feature="http://org.eclipse.daanse.board.app.ui.vue.widget.maplibre#//PartEncoding/color" label="maplibre:Symbols.PartEncoding.color"/>
  </components>
</uimodel:UIModel>
