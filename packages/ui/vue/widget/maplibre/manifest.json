{
  "$schema": "https://tsm.dev/schema/manifest/v1.json",
  "id": "ui.vue.widget.maplibre",
  "name": "3D Map Widget",
  "version": "0.0.1-next.1",
  "description": "A map drawn with MapLibre GL: tilted, turned, with buildings and terrain in 3D",
  "entry": "/bundles/ui.vue.widget.maplibre/index.js",
  "exports": {},
  "dependencies": [
    "lib.api.datasource",
    "lib.api.events",
    "lib.api.widget",
    "lib.datasource.base",
    "lib.datasource.ogcsta",
    "lib.events",
    "platform.vue",
    "ui.vue.common.map",
    "ui.vue.composables",
    "ui.vue.controls",
    "ui.vue.uimodel"
  ],
  "requiresService": [
    {
      "id": "EventRegistry"
    },
    {
      "id": "EventActionsRegistry"
    }
  ],
  "sharedDependencies": [
    {
      "id": "vue",
      "versionRange": "^3.5.0"
    },
    {
      "id": "vue-router",
      "versionRange": "^5.0.0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.datasource",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.events",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.widget",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.core",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.datasource.ogcsta",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.events",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.composables",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.controls",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "@emfts/core",
      "versionRange": "^0.3.0-next.6"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.common.map",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.uimodel",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.datasource.base",
      "versionRange": ">=0.0.1-0"
    }
  ],
  "capabilities": [
    {
      "namespace": "tsm.i18n",
      "attributes": {
        "namespace": "maplibre",
        "languages": [
          "de",
          "en"
        ]
      }
    }
  ]
}
