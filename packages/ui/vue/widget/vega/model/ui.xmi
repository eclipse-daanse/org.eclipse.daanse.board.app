The form of the Vega-Lite chart (#1285). The chart is configured here and
nowhere else; the widget compiles the spec from what this form writes.

The chart first, then its parts: the layers carry the marks and their
encodings, each in a form of its own (ui-layer.xmi, ui-encoding.xmi); the
small multiples and the selections follow.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="VegaWidgetSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings"/>

  <components xsi:type="uimodel:FormView" name="VegaWidgetSettingsFormView">
    <fields xsi:type="uimodel:SelectWidget"
        name="starter"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/starter"
        label="vega:Form.starter">
      <values>none</values>
      <values>bar</values>
      <values>stackedBar</values>
      <values>groupedBar</values>
      <values>line</values>
      <values>area</values>
      <values>scatter</values>
      <values>heatmap</values>
      <values>histogram</values>
      <values>boxplot</values>
      <values>donut</values>
      <values>brush</values>
      <optionLabel language="JS" body="({ none: 'vega:Options.starter.none', bar: 'vega:Options.starter.bar', stackedBar: 'vega:Options.starter.stackedBar', groupedBar: 'vega:Options.starter.groupedBar', line: 'vega:Options.starter.line', area: 'vega:Options.starter.area', scatter: 'vega:Options.starter.scatter', heatmap: 'vega:Options.starter.heatmap', histogram: 'vega:Options.starter.histogram', boxplot: 'vega:Options.starter.boxplot', donut: 'vega:Options.starter.donut', brush: 'vega:Options.starter.brush' })[option] ?? option"/>
    </fields>
    <fields xsi:type="uimodel:InputWidget"
        name="title"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/title"
        label="vega:Form.title"/>
    <fields xsi:type="uimodel:InputWidget"
        name="layers"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/layers"
        label="vega:Form.layers"
        placeholder="vega:Form.layersHint"/>
    <fields xsi:type="uimodel:InputWidget"
        name="datasets"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/datasets"
        label="vega:Form.datasets"
        placeholder="vega:Form.datasetsHint"/>
    <fields xsi:type="uimodel:InputWidget"
        name="facet"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/facet"
        label="vega:Form.facet"/>
    <fields xsi:type="uimodel:InputWidget"
        name="params"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/params"
        label="vega:Form.params"
        placeholder="vega:Form.paramsHint"/>
    <fields xsi:type="uimodel:InputWidget"
        name="references"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/references"
        label="vega:Form.references"
        placeholder="vega:Form.referencesHint"/>
    <fields xsi:type="uimodel:SelectWidget"
        name="independentScales"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/independentScales"
        label="vega:Form.independentScales" multiSelect="true">
      <values>y</values>
      <values>x</values>
      <values>color</values>
      <values>size</values>
      <values>opacity</values>
      <optionLabel language="JS" body="({ y: 'vega:Options.channel.y', x: 'vega:Options.channel.x', color: 'vega:Options.channel.color', size: 'vega:Options.channel.size', opacity: 'vega:Options.channel.opacity' })[option] ?? option"/>
      <visibilityCondition language="JS" body="self.layers.size() &gt; 1 || !!(self.facet &amp;&amp; (self.facet.row || self.facet.column))"/>
    </fields>
    <fields xsi:type="uimodel:SelectWidget"
        name="legendPosition"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/legendPosition"
        label="vega:Form.legendPosition">
      <values>right</values>
      <values>bottom</values>
      <values>top</values>
      <values>left</values>
      <values>none</values>
      <optionLabel language="JS" body="({ right: 'vega:Options.legendPosition.right', bottom: 'vega:Options.legendPosition.bottom', top: 'vega:Options.legendPosition.top', left: 'vega:Options.legendPosition.left', none: 'vega:Options.legendPosition.none' })[option] ?? option"/>
    </fields>
    <fields xsi:type="uimodel:CheckboxWidget"
        name="tooltip"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/tooltip"
        label="vega:Form.tooltip"/>
    <fields xsi:type="uimodel:SelectWidget"
        name="renderer"
        feature="http://org.eclipse.daanse.board.app.ui.vue.widget.vega#//VegaWidgetSettings/renderer"
        label="vega:Form.renderer">
      <values>canvas</values>
      <values>svg</values>
      <optionLabel language="JS" body="({ canvas: 'vega:Options.renderer.canvas', svg: 'vega:Options.renderer.svg' })[option] ?? option"/>
    </fields>
  </components>
</uimodel:UIModel>
