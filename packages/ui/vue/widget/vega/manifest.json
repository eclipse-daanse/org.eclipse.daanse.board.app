{
  "$schema": "https://tsm.dev/schema/manifest/v1.json",
  "id": "ui.vue.widget.vega",
  "name": "Vega-Lite Chart Widget",
  "version": "0.0.1-next.1",
  "description": "A chart drawn with Vega-Lite, configured by a model-driven form",
  "entry": "/bundles/ui.vue.widget.vega/index.js",
  "exports": {},
  "dependencies": [
    "lib.api.datasource",
    "lib.api.events",
    "lib.api.widget",
    "lib.datasource.base",
    "lib.events",
    "platform.vue",
    "ui.vue.composables"
  ],
  "requiresService": [
    {
      "id": "DatasourceRepository"
    },
    {
      "id": "EventRegistry"
    }
  ],
  "sharedDependencies": [
    {
      "id": "vue",
      "versionRange": "^3.5.0"
    },
    {
      "id": "vue-router",
      "versionRange": "^5.0.0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.events",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.events",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.datasource",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.widget",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.core",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.composables",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "@emfts/core",
      "versionRange": "^0.3.0-next.6"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.datasource.base",
      "versionRange": ">=0.0.1-0"
    }
  ],
  "capabilities": [
    {
      "namespace": "tsm.i18n",
      "attributes": {
        "namespace": "vega",
        "languages": [
          "de",
          "en"
        ]
      }
    }
  ]
}
