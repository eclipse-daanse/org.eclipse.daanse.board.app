The form for the multi-state button.

The states first - they are what the button is - then where it writes,
and last how it looks while it holds none of them.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="MultiStateSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings"/>

  <components xsi:type="uimodel:FormView" name="MultiStateSettingsFormView">

    <fields xsi:type="uimodel:GroupWidget" name="statesGroup" layout="VERTICAL" label="control:Form.statesGroup">
      <fields xsi:type="uimodel:InputWidget" name="states"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/states" label="control:Form.states"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="writeGroup" layout="VERTICAL" label="control:Form.writeGroup">
      <fields xsi:type="uimodel:InputWidget" name="target"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/target" label="control:Form.target"/>
      <fields xsi:type="uimodel:InputWidget" name="disabled"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/disabled" label="control:Form.disabled" placeholder="false"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="lookGroup" layout="VERTICAL" label="control:Form.lookGroup">
      <fields xsi:type="uimodel:InputWidget" name="label"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/label" label="control:Form.noStateLabel"/>
      <fields xsi:type="uimodel:InputWidget" name="color"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/color" label="control:Form.color"/>
      <fields xsi:type="uimodel:InputWidget" name="textColor"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/textColor" label="control:Form.textColor"/>
      <fields xsi:type="uimodel:NumberWidget" name="fontSize"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//MultiStateSettings/fontSize" label="control:Form.fontSize" min="6" max="200" step="1"/>
    </fields>

  </components>
</uimodel:UIModel>
