The form for the slider.

The scale first, then its marks, then where it writes - a second variable
only once it is a range - and last how it looks.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="SliderSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings"/>

  <components xsi:type="uimodel:FormView" name="SliderSettingsFormView">

    <fields xsi:type="uimodel:GroupWidget" name="scaleGroup" layout="VERTICAL" label="control:Form.scaleGroup">
      <fields xsi:type="uimodel:NumberWidget" name="min"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/min" label="control:Form.min"/>
      <fields xsi:type="uimodel:NumberWidget" name="max"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/max" label="control:Form.max"/>
      <fields xsi:type="uimodel:NumberWidget" name="step"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/step" label="control:Form.step"/>
      <fields xsi:type="uimodel:InputWidget" name="unit"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/unit" label="control:Form.unit" placeholder="%"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="marksGroup" layout="VERTICAL" label="control:Form.marksGroup">
      <fields xsi:type="uimodel:InputWidget" name="detents"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/detents" label="control:Form.detents"/>
      <fields xsi:type="uimodel:InputWidget" name="marks"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/marks" label="control:Form.marks"/>
      <fields xsi:type="uimodel:NumberWidget" name="markEvery"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/markEvery" label="control:Form.markEvery" min="1" step="1"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="snap"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/snap" label="control:Form.snap"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="writeGroup" layout="VERTICAL" label="control:Form.slideGroup">
      <fields xsi:type="uimodel:CheckboxWidget" name="range"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/range" label="control:Form.range"/>
      <fields xsi:type="uimodel:InputWidget" name="target"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/target" label="control:Form.target"/>
      <fields xsi:type="uimodel:InputWidget" name="upperTarget"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/upperTarget" label="control:Form.upperTarget">
        <visibilityCondition language="JS" body="self.range === true"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="disabled"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/disabled" label="control:Form.disabled" placeholder="false"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="lookGroup" layout="VERTICAL" label="control:Form.lookGroup">
      <fields xsi:type="uimodel:InputWidget" name="label"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/label" label="control:Form.label"/>
      <fields xsi:type="uimodel:CheckboxWidget" name="showValue"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/showValue" label="control:Form.showValue"/>
      <fields xsi:type="uimodel:SelectWidget" name="orientation"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/orientation" label="control:Form.orientation">
        <values>horizontal</values>
        <values>vertical</values>
        <optionLabel language="JS" body="({ horizontal: 'control:Options.orientation.horizontal', vertical: 'control:Options.orientation.vertical' })[String(option).toLowerCase()] ?? option"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="color"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/color" label="control:Form.color"/>
      <fields xsi:type="uimodel:InputWidget" name="textColor"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/textColor" label="control:Form.valueTextColor"/>
      <fields xsi:type="uimodel:NumberWidget" name="fontSize"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//SliderSettings/fontSize" label="control:Form.fontSize" min="6" max="200" step="1"/>
    </fields>

  </components>
</uimodel:UIModel>
