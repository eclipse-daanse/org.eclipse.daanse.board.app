The form for the choice, a dropdown.

The options first - listed, then where in the source's answer more are
found - then where the choice is written, and last how it looks. The
fields of a source's items are only asked for once there is a path to the
list.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="ChoiceSettingsForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings"/>

  <components xsi:type="uimodel:FormView" name="ChoiceSettingsFormView">

    <fields xsi:type="uimodel:GroupWidget" name="optionsGroup" layout="VERTICAL" label="control:Form.optionsGroup">
      <fields xsi:type="uimodel:InputWidget" name="options"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/options" label="control:Form.options"/>
      <fields xsi:type="uimodel:InputWidget" name="optionsPath"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/optionsPath" label="control:Form.optionsPath" placeholder="rows"/>
      <fields xsi:type="uimodel:InputWidget" name="optionLabel"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/optionLabel" label="control:Form.optionLabel" placeholder="name">
        <visibilityCondition language="JS" body="!!(self.optionsPath?.value ?? self.optionsPath)"/>
      </fields>
      <fields xsi:type="uimodel:InputWidget" name="optionValue"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/optionValue" label="control:Form.optionValue" placeholder="id">
        <visibilityCondition language="JS" body="!!(self.optionsPath?.value ?? self.optionsPath)"/>
      </fields>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="writeGroup" layout="VERTICAL" label="control:Form.chooseGroup">
      <fields xsi:type="uimodel:InputWidget" name="target"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/target" label="control:Form.target"/>
      <fields xsi:type="uimodel:InputWidget" name="disabled"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/disabled" label="control:Form.disabled" placeholder="false"/>
    </fields>

    <fields xsi:type="uimodel:GroupWidget" name="lookGroup" layout="VERTICAL" label="control:Form.lookGroup">
      <fields xsi:type="uimodel:InputWidget" name="label"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/label" label="control:Form.label"/>
      <fields xsi:type="uimodel:InputWidget" name="placeholder"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/placeholder" label="control:Form.placeholder"/>
      <fields xsi:type="uimodel:InputWidget" name="color"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/color" label="control:Form.color"/>
      <fields xsi:type="uimodel:NumberWidget" name="fontSize"
          feature="http://org.eclipse.daanse.board.app.ui.vue.widget.control#//ChoiceSettings/fontSize" label="control:Form.fontSize" min="6" max="200" step="1"/>
    </fields>

  </components>
</uimodel:UIModel>
