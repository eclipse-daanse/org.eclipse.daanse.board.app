<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="richTextEditor"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.widget.text.rich" nsPrefix="richTextEditor">
    <eClassifiers xsi:type="ecore:EClass" name="RichTextEditorSettings">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="What a rich text widget is told: the text itself, and the size and colour it is drawn in when the text says nothing else."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="editor" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The rich text itself, as HTML, with {variable} placeholders left in it for the widget to substitute. The name says editor because that is what a board already stored it under."/>
            </eAnnotations>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontSize" containment="false" defaultValueLiteral="16">
            <eGenericType eClassifier="org.eclipse.daanse.board.app.ui.vue.composables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontColor" containment="false" defaultValueLiteral="#000000">
            <eGenericType eClassifier="org.eclipse.daanse.board.app.ui.vue.composables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>
    </eClassifiers>
</ecore:EPackage>
