<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="textsettings"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.widget.text.plain"
                nsPrefix="textsettings">

    <eClassifiers xsi:type="ecore:EClass" name="TextSettings">

        <eStructuralFeatures xsi:type="ecore:EReference" name="text" containment="false" defaultValueLiteral="">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The text the widget shows. A $value placeholder is replaced with the data of the assigned datasource: $value on its own inserts the whole object, $value.name one of its fields, $value.items.0.title an entry of a list. A {variable} placeholder is replaced with a board variable, which is a different thing."/>
            </eAnnotations>
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.ui.vue.composables#//VariableComplexStringWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontSize" containment="false" defaultValueLiteral="12">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontColor" containment="false" defaultValueLiteral="#000">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontWeight" containment="false" defaultValueLiteral="normal">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="fontStyle" containment="false" defaultValueLiteral="normal">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="textDecoration" containment="false" defaultValueLiteral="none">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="horizontalAlign" containment="false" defaultValueLiteral="Left">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

        <eStructuralFeatures xsi:type="ecore:EReference" name="verticalAlign" containment="false" defaultValueLiteral="Top">
            <eGenericType eClassifier="http://org.eclipse.daanse.board.app.lib.variables#//VariableWrapper">
                <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </eGenericType>
        </eStructuralFeatures>

    </eClassifiers>

</ecore:EPackage>
