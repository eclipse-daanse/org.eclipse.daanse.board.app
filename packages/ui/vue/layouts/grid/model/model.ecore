The grid layout's settings.

A row height, and how many columns the grid has at each width the layout
knows. The five are one object rather than five fields on the settings,
because they are one decision made five times - and because that is the
shape resolveGridSettings already merges against its defaults.

The breakpoints themselves are not settings: they are the widths the layout
switches at, and a board that moved them would lay out differently on one
screen than the widget positions were placed for.
-->
<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="gridsettings"
                nsURI="http://org.eclipse.daanse.board.app.ui.vue.layouts.grid"
                nsPrefix="gridsettings">

    <eClassifiers xsi:type="ecore:EClass" name="GridColumns">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="lg"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="18"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="md"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="12"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="sm"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="6"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="xs"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="4"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="xxs"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="2"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="GridSettings">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="rowHeight"
                             eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
                             defaultValueLiteral="30"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="cols"
                             eType="#//GridColumns" containment="true"/>
    </eClassifiers>
</ecore:EPackage>
