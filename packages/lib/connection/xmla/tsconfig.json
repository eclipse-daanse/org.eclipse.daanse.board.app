{
  "exclude": ["node_modules", "dist", "dist-bundle", "vite.bundle.config.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "module": "commonjs",

    "declaration": true,
    "outDir": "./dist/types",

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "skipLibCheck": true
  }
}
