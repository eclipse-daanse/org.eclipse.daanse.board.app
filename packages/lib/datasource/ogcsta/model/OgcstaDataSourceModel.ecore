<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="ogcsta"
                nsURI="http://org.eclipse.daanse.board.app.lib.datasource.ogcsta" nsPrefix="ogcsta">

    <eSubpackages href="http://org.eclipse.daanse.board.app.lib.datasource.base#/"/>

    <eClassifiers xsi:type="ecore:EClass" name="IOGCSTAConfiguration">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Configuration for an OGC SensorThings API (OGCSTA) data source, extending the base connection configuration."/>
        </eAnnotations>
        <eSuperTypes href="http://org.eclipse.daanse.board.app.lib.datasource.base#//IBaseConnectionConfiguration"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="connection" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="A reference or ID to a specific OGCSTA connection endpoint."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="latestValues" eType="#//OGCSTALatestValues" lowerBound="0" containment="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="A flat view of the latest values: one row per thing, a column per datastream of it. A source with this view answers a table with it; without it a table gets what it got before."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="OGCSTALatestValues">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The latest values of the things a filter matches, as rows of a table. The datastreams of a row are found by their ids - the thing id followed by a column's suffix - and read directly, never by a filter on /Datastreams: that collection is incomplete on some servers (#1250, #1264)."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="thingNames" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" lowerBound="0" upperBound="-1">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Which things are rows, by name, read as the map reads a thing rule on the name: Reference Area* starts with, *-derived ends with, *x* contains, no star is equality. A thing that matches any of them is a row. Without any, the view has no rows: a table of every thing of a server is not what anybody asks for."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="nameColumn" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="name">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The header of the column that holds the name of the thing. Empty: no such column."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="idColumn" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The header of the column that holds the id of the thing. Empty: no such column."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="columns" eType="#//OGCSTALatestValueColumn" lowerBound="0" upperBound="-1" containment="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The columns after the name and the id, in this order."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="OGCSTALatestValuePart">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Which part of the latest observation a column shows. The literal is what a column holds."/>
        </eAnnotations>
        <eLiterals name="RESULT" literal="result"/>
        <eLiterals name="PHENOMENON_TIME" literal="phenomenonTime" value="1"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="OGCSTALatestValueColumn">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="One column of the view: a part of the latest observation of one datastream of each thing. Two columns on the same datastream - its result and its time - cause one request."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="suffix" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The datastream of the thing, by the end of its id: the thing id followed by this, for example ~referenceArea~color."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The header of the column. Empty: the suffix."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="part" eType="#//OGCSTALatestValuePart" defaultValueLiteral="result">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Which part of the latest observation the column shows: its result, or its phenomenon time in local time as YYYY-MM-DD HH:mm."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="mappings" eType="#//OGCSTAValueMapping" lowerBound="0" upperBound="-1" containment="true">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="What a result means: a code of the server shown as a word, optionally with a colour. A result without a mapping is shown as it came."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="OGCSTAValueMapping">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="One code of a result and what is shown for it, for example BLUE as feucht in blue."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="The result as the server sends it, compared as text."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="What the cell shows for the code. Empty: the code."/>
            </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="A CSS colour for the cell. The table answer carries it beside the rows, by column and shown value, and a data table paints the cell with it. Empty: no colour."/>
            </eAnnotations>
        </eStructuralFeatures>
    </eClassifiers>

</ecore:EPackage>
