{
  "exclude": ["node_modules", "dist", "dist-bundle", "vite.bundle.config.ts"],
  "compilerOptions": {
    "sourceMap": true,
    "declarationMap": true,
    "inlineSources": true,
    "target": "es2016"
,
    "experimentalDecorators": true
,
    "emitDecoratorMetadata": true
,
    "module": "commonjs"
,
    "declaration": true
,
    "esModuleInterop": true
,
    "forceConsistentCasingInFileNames": true
,
    "strict": true
,
    "skipLibCheck": true
  }
}
