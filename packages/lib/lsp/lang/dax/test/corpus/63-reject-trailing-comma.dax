// Source: https://learn.microsoft.com/en-us/dax/isdouble-function-dax (example 1)
// Construct: A trailing comma before `}` in a table constructor.
// Expect: reject
// Reference: rejects - Encountered an error at (or somewhere around) input:8:24
// Normalized: as published.
EVALUATE
{
    IF ( ISDOUBLE ( 4.2 ), "Is double", "Is not double" ), // RETURNS: Is double
    IF ( ISDOUBLE ( 3.1E-1 ), "Is double", "Is not double" ), // RETURNS: Is double
    IF ( ISDOUBLE ( "42" ), "Is double", "Is not double" ), // RETURNS: Is not double
    IF ( ISDOUBLE ( 42 ), "Is double", "Is not double" ), // RETURNS: Is not double
}
