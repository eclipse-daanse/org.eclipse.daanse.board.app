{
  "name": "org.eclipse.daanse.board.app.lib.lsp.lang.dax",
  "version": "0.0.1-next.1",
  "private": true,
  "description": "DAX (Data Analysis Expressions) language package: grammar, language server, diagnostics, CodeMirror highlighting and examples.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./dist/org.eclipse.daanse.board.app.lib.lsp.lang.dax.js",
  "types": "./src/index.ts",
  "files": [
    "src",
    "worker",
    "examples",
    "dist"
  ],
  "scripts": {
    "generate": "langium generate && prettier --write src/language/generated",
    "refresh-functions": "node scripts/refresh-functions.mjs && prettier --write src/language/generated-functions",
    "record-corpus": "node scripts/record-corpus.mjs",
    "build": "vite build && vite build --config vite.worker.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/language": "~6.12.4",
    "@lezer/highlight": "~1.2.3",
    "langium": "~4.3.1",
    "org.eclipse.daanse.board.app.lib.lsp.core": "^0.0.1-next.1",
    "vscode-languageserver": "~10.0.1",
    "vscode-languageserver-types": "~3.17.5",
    "@eclipse-daanse/tsm": "0.1.0-next.1",
    "org.eclipse.daanse.board.app.lib.api.lsp": "^0.0.1-next.1",
    "org.eclipse.daanse.board.app.lib.core": "^0.0.1-next.1",
    "org.eclipse.daanse.board.app.lib.lsp.server": "^0.0.1-next.1"
  },
  "devDependencies": {
    "langium-cli": "~4.3.0",
    "typescript": "~5.9.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^4.0.16"
  },
  "license": "EPL-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./manifest.json": "./manifest.json"
  }
}
