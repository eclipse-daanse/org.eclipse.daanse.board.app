-- Source: https://learn.microsoft.com/en-us/analysis-services/instances/use-dynamic-management-views-dmvs-to-monitor-analysis-services
-- Construct: WHERE on its own line, single-quoted literal.
-- Expect: parse
-- Normalized: identifiers and string values substituted; casing, spacing,
--             line breaks and quoting preserved exactly as published.
SELECT * FROM $System.DISCOVER_ITEM_DEPENDENCY
WHERE OBJECT_TYPE = 'ACTIVE_LINKAGE'
