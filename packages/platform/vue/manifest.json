{
  "$schema": "https://tsm.dev/schema/manifest/v1.json",
  "id": "platform.vue",
  "name": "Vue Platform Libraries",
  "version": "0.0.1-next.1",
  "description": "Provides vue and vue-router as shared libraries",
  "entry": "/bundles/platform.vue/index.js",
  "exports": {},
  "capabilities": [
    {
      "namespace": "tsm.library",
      "attributes": {
        "library": "vue",
        "version": "3.5.24"
      }
    },
    {
      "namespace": "tsm.library",
      "attributes": {
        "library": "vue-router",
        "version": "5.0.6"
      }
    },
    {
      "namespace": "tsm.library",
      "attributes": {
        "library": "vuedraggable",
        "version": "4.1.0"
      }
    },
    {
      "namespace": "tsm.library",
      "attributes": {
        "library": "@emfts/core",
        "version": "0.1.1-next.18"
      }
    }
  ]
}
