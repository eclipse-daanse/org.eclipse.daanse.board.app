The form for a page's lighting, in the page settings.

Here beside the weather's form and for the same reason: the labels are the
page settings' own words. One setting so far, the ambient light; the lamps
that shine on the page are widgets and are set up in their own settings.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="LightingForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.lib.model.workspace#//Lighting"/>

  <components xsi:type="uimodel:FormView" name="LightingFormView">
    <fields xsi:type="uimodel:NumberWidget" name="ambient"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Lighting/ambient" label="shell:PageSettings.lighting.ambient"
        min="0" max="100" step="5"/>
  </components>
</uimodel:UIModel>
