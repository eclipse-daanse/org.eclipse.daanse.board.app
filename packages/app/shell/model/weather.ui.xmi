The form for a page's weather, in the page settings.

Here rather than beside workspace.ecore: the labels are the page settings'
own words, and the model package carries no texts. The kind first, because
the other three mean nothing while it is none; they stay visible all the
same, so a variable bound to one of them is not hidden away while the kind
happens to be none.

The kinds are the model's literals, which is what a page stores and what a
variable has to say; optionLabel gives them the words. Fog is in the model
and not offered yet: the layer does not draw it (#1228, second part).

The region's area is in grid units of the page's layout. The widget a
widget region follows is one of the page's own, so its choices cannot be
written here: the page settings put one value per widget where the
"widget choices" comment stands, with the words for each in optionLabel.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="WeatherForm">

  <targetClasses href="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather"/>

  <components xsi:type="uimodel:FormView" name="WeatherFormView">
    <fields xsi:type="uimodel:SelectWidget" name="kind"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/kind" label="shell:PageSettings.weather.kind">
      <values>none</values>
      <values>rain</values>
      <values>snow</values>
      <optionLabel language="JS" body="({ none: 'shell:PageSettings.weather.none', rain: 'shell:PageSettings.weather.rain', snow: 'shell:PageSettings.weather.snow' })[option] ?? option"/>
    </fields>
    <fields xsi:type="uimodel:NumberWidget" name="intensity"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/intensity" label="shell:PageSettings.weather.intensity"
        min="0" max="100" step="5"/>
    <fields xsi:type="uimodel:NumberWidget" name="wind"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/wind" label="shell:PageSettings.weather.wind"
        min="-100" max="100" step="5"/>
    <fields xsi:type="uimodel:InputWidget" name="color"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/color" label="shell:PageSettings.weather.color"
        placeholder="#ffffff"/>
    <fields xsi:type="uimodel:SelectWidget" name="region"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/region" label="shell:PageSettings.weather.region">
      <values>page</values>
      <values>area</values>
      <values>widget</values>
      <optionLabel language="JS" body="({ page: 'shell:PageSettings.weather.regionPage', area: 'shell:PageSettings.weather.regionArea', widget: 'shell:PageSettings.weather.regionWidget' })[option] ?? option"/>
    </fields>
    <fields xsi:type="uimodel:NumberWidget" name="regionX"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/regionX" label="shell:PageSettings.weather.regionX" min="0" step="1"/>
    <fields xsi:type="uimodel:NumberWidget" name="regionY"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/regionY" label="shell:PageSettings.weather.regionY" min="0" step="1"/>
    <fields xsi:type="uimodel:NumberWidget" name="regionWidth"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/regionWidth" label="shell:PageSettings.weather.regionWidth" min="1" step="1"/>
    <fields xsi:type="uimodel:NumberWidget" name="regionHeight"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/regionHeight" label="shell:PageSettings.weather.regionHeight" min="1" step="1"/>
    <fields xsi:type="uimodel:SelectWidget" name="regionWidget"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/regionWidget" label="shell:PageSettings.weather.regionWidgetChoice">
      <!-- widget choices -->
    </fields>
    <fields xsi:type="uimodel:CheckboxWidget" name="affectsWidgets"
        feature="http://org.eclipse.daanse.board.app.lib.model.workspace#//Weather/affectsWidgets" label="shell:PageSettings.weather.affectsWidgets" asToggle="true"/>
  </components>
</uimodel:UIModel>
