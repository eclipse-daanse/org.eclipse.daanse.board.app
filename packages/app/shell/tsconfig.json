{
  "exclude": ["node_modules", "dist", "dist-bundle", "vite.bundle.config.ts"],
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
