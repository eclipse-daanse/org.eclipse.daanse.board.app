{
  "$schema": "https://tsm.dev/schema/manifest/v1.json",
  "id": "app.workbench",
  "name": "MDX Workbench",
  "version": "0.0.1-next.1",
  "description": "The MDX workbench: connection, cube explorer, editor, trees, results, history and request log",
  "entry": "/bundles/app.workbench/index.js",
  "exports": {},
  "dependencies": [
    "lib.api.connection",
    "lib.api.datasource",
    "lib.api.lsp",
    "lib.api.widget",
    "lib.connection.xmla",
    "lib.datasource.xmla",
    "lib.i18next",
    "lib.lsp.core",
    "lib.lsp.lang.mdx",
    "platform.codemirror",
    "platform.vue",
    "ui.vue.common.lsp",
    "ui.vue.common.xmla",
    "ui.vue.composables",
    "ui.vue.controls",
    "ui.vue.uimodel"
  ],
  "provides": [
    {
      "id": "App",
      "description": "The mounted Vue application instance"
    },
    {
      "id": "WorkbenchAnswerSource",
      "description": "Store factory of the workbench.answer datasource type: the answer on screen, for the chart view"
    }
  ],
  "requiresService": [
    {
      "id": "ConnectionRepository"
    },
    {
      "id": "DatasourceRepository"
    },
    {
      "id": "XmlaTraffic"
    },
    {
      "id": "XmlaStoreFactory",
      "optional": true
    },
    {
      "id": "XmlaConnectionSettings",
      "optional": true
    },
    {
      "id": "WidgetRepository",
      "optional": true
    }
  ],
  "sharedDependencies": [
    {
      "id": "vue",
      "versionRange": "^3.5.0"
    },
    {
      "id": "vue-router",
      "versionRange": "^5.0.0"
    },
    {
      "id": "@codemirror/state",
      "versionRange": "^6.7.1"
    },
    {
      "id": "@codemirror/view",
      "versionRange": "^6.43.8"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.core",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.connection",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.datasource",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.connection.xmla",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.datasource.xmla",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.lsp",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.lsp.core",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.lsp.lang.mdx",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.i18next",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.common.lsp",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.common.xmla",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.controls",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.composables",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.lib.api.widget",
      "versionRange": ">=0.0.1-0"
    },
    {
      "id": "org.eclipse.daanse.board.app.ui.vue.uimodel",
      "versionRange": ">=0.0.1-0"
    }
  ],
  "capabilities": [
    {
      "namespace": "tsm.i18n",
      "attributes": {
        "namespace": "workbench",
        "languages": [
          "de",
          "en"
        ]
      }
    }
  ]
}
